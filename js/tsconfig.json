{
  "compilerOptions": {
    "newLine": "LF",
    "strictNullChecks": true,
    "noUnusedLocals" : true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "outDir": "./dist/",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "target": "es2017",
    "module": "commonJS",
    "paths": {
      "*": ["./typings/*"]
    }
  },
  "exclude": [
    "node_modules"
    ]
}
